APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-at-least-64-random-hex-characters
APP_INSTALLER_ENABLED=0
DEFAULT_URI=https://club.example.ch
APP_TRUSTED_HOST='^club\.example\.ch$'
DATABASE_URL='mysql://database-user:database-password@database-host:3306/database-name?serverVersion=10.6.0-MariaDB&charset=utf8mb4'
LOCK_DSN=flock
MAILER_DSN='smtp://smtp-user:smtp-password@smtp-host:587?encryption=tls&auth_mode=login'
MAIL_FROM='Vereinssport Schweiz <noreply@club.example.ch>'
PLATFORM_EMERGENCY_RECOVERY_TOKEN=replace-with-a-long-random-emergency-token

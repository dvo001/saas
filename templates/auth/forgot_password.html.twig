{% extends 'base.html.twig' %}
{% block title %}Passwort zurücksetzen{% endblock %}
{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><p class="eyebrow">{{ tenant.name }}</p><h1 class="h3">Passwort zurücksetzen</h1>{% if sent %}<div class="alert alert-success">Falls ein aktives Konto existiert, wurde ein 60 Minuten gültiger Link versendet.</div>{% else %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('password_forgot') }}"><label class="form-label" for="email">E-Mail-Adresse</label><input class="form-control mb-3" type="email" id="email" name="email" required autofocus><button class="btn btn-primary" type="submit">Link anfordern</button></form>{% endif %}</div></div></main>{% endblock %}

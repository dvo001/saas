{% extends 'base.html.twig' %}
{% block title %}Einladung annehmen{% endblock %}
{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="h3">Einladung annehmen</h1><p class="text-body-secondary">Vervollständigen Sie Ihr Konto. Einladungen sind 7 Tage und nur einmal gültig.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('invitation_' ~ token) }}"><div class="mb-3"><label class="form-label" for="display_name">Vor- und Nachname</label><input class="form-control" id="display_name" name="display_name" required autofocus></div><div class="mb-3"><label class="form-label" for="password">Passwort</label><input class="form-control" id="password" name="password" type="password" minlength="12" autocomplete="new-password" required></div><button class="btn btn-primary" type="submit">Konto aktivieren</button></form></div></div></main>{% endblock %}

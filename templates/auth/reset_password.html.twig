{% extends 'base.html.twig' %}
{% block title %}Neues Passwort{% endblock %}
{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="h3">Neues Passwort setzen</h1>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset_' ~ token) }}"><label class="form-label" for="password">Neues Passwort</label><input class="form-control mb-3" type="password" id="password" name="password" minlength="12" autocomplete="new-password" required autofocus><button class="btn btn-primary" type="submit">Passwort ändern</button></form></div></div></main>{% endblock %}

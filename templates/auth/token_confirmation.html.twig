{% extends 'base.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block shell %}
<main id="main-content" class="container py-5 auth-shell">
    <div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5">
        <h1 class="h3">{{ title }}</h1>
        <p class="text-body-secondary">{{ message }}</p>
        <form method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrf_id) }}">
            <button class="btn btn-primary" type="submit">{{ button }}</button>
        </form>
    </div></div>
</main>
{% endblock %}

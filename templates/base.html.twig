<!doctype html>
<html lang="de-CH" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="/assets/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    {% block stylesheets %}{% endblock %}
    <script src="/assets/js/theme.js" defer></script>
    <script src="/assets/js/revision-poller.js" defer></script>
</head>
<body>
    <a class="visually-hidden-focusable" href="#main-content">Zum Inhalt springen</a>
    {% block shell %}
        <nav class="navbar navbar-expand-lg border-bottom bg-body sticky-top" aria-label="Hauptnavigation">
            <div class="container-xl">
                <a class="navbar-brand fw-semibold" href="/">{{ app_name }}</a>
                <button class="navbar-toggler" type="button" data-nav-toggle aria-controls="main-navigation" aria-expanded="false" aria-label="Navigation öffnen">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation" data-nav>
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {% if is_granted('ROLE_TENANT_USER') %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('tenant_dashboard',{slug:app.user.tenant.slug}) }}">{{ 'nav.dashboard'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('tenant_events',{slug:app.user.tenant.slug}) }}">{{ 'nav.events'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('tenant_registries',{slug:app.user.tenant.slug}) }}">{{ 'nav.master_data'|trans }}</a></li>
                        {% elseif is_granted('ROLE_PLATFORM_ADMIN') %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('platform_dashboard') }}">Plattform</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('platform_tenants') }}">Vereine</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('platform_invoices') }}">Rechnungen</a></li>
                        {% else %}
                            <li class="nav-item"><a class="nav-link" href="{{ path('registration') }}">Verein registrieren</a></li>
                            <li class="nav-item"><a class="nav-link" href="{{ path('platform_login') }}">Plattformlogin</a></li>
                        {% endif %}
                    </ul>
                    <button class="btn btn-outline-secondary btn-sm" type="button" data-theme-toggle aria-label="Farbschema wechseln">◐ <span>Darstellung</span></button>
                </div>
            </div>
        </nav>
        {% if is_granted('ROLE_SUPPORT_IMPERSONATION') %}
            <div class="alert alert-danger rounded-0 border-start-0 border-end-0 mb-0 sticky-top" role="alert">
                <div class="container-xl d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <div><strong>Supportmodus aktiv</strong> · Du arbeitest im Verein {{ app.user.tenant.name }} als {{ app.user.displayName }}.{% if app.request.attributes.get('support_session') %} Grund: {{ app.request.attributes.get('support_session').reason }}{% endif %}</div>
                    <form method="post" action="{{ path('tenant_support_end', {slug: app.user.tenant.slug}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('end_support') }}"><button class="btn btn-danger btn-sm" type="submit">Supportmodus beenden</button></form>
                </div>
            </div>
        {% endif %}
        <main id="main-content" class="container-xl py-4 py-lg-5">
            {% block body %}{% endblock %}
        </main>
    {% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>

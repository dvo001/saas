{% extends 'base.html.twig' %}

{% block title %}Dashboard · {{ platform_name }}{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end mb-4">
        <div>
            <span class="eyebrow">Version 1</span>
            <h1 class="display-6 fw-semibold mb-2">{{ platform_name }}</h1>
            <p class="text-body-secondary mb-0">Vereinsverwaltung für Laufanlässe und Fussballturniere – mandantenfähig, sicher und für Schweizer Shared Hosting ausgelegt.</p>
        </div>
        <button class="btn btn-outline-secondary" type="button" data-theme-toggle>◐ Darstellung wechseln</button>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot status-ok"></span><h2 class="h5 mt-3">Laufanlässe</h2><p class="text-body-secondary">Teilnehmende, Qualifikationsläufe, Finalisten, Ranglisten und PDFs in einem durchgängigen Ablauf.</p></div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot status-ok"></span><h2 class="h5 mt-3">Fussballturniere</h2><p class="text-body-secondary">Flexible Kategorien, Gruppen, Spielplanung, Resultate, K.-o.-Runden und Veröffentlichungen.</p></div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot"></span><h2 class="h5 mt-3">Verein starten</h2><p class="text-body-secondary">Verein registrieren und das gewählte Sportmodul 14 Tage testen.</p><a class="btn btn-primary" href="{{ path('registration') }}">Verein registrieren</a></div></section>
        </div>
    </div>
{% endblock %}

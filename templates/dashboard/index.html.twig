{% extends 'base.html.twig' %}

{% block title %}Dashboard · {{ platform_name }}{% endblock %}

{% block body %}
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end mb-4">
        <div>
            <span class="eyebrow">Application Core</span>
            <h1 class="display-6 fw-semibold mb-2">{{ platform_name }}</h1>
            <p class="text-body-secondary mb-0">Die technische Basis ist installiert. Vereine und Veranstaltungen folgen in den nächsten Milestones.</p>
        </div>
        <button class="btn btn-outline-secondary" type="button" data-theme-toggle>◐ Darstellung wechseln</button>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot status-ok"></span><h2 class="h5 mt-3">System bereit</h2><p class="text-body-secondary mb-0">Konfiguration, Migrationen und private Dateistruktur sind aktiv.</p></div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot status-next"></span><h2 class="h5 mt-3">Nächster Schritt</h2><p class="text-body-secondary mb-0">Authentifizierung, Mandanten und Rollen werden in Milestone 2 umgesetzt.</p></div></section>
        </div>
        <div class="col-md-6 col-xl-4">
            <section class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="status-dot"></span><h2 class="h5 mt-3">Zeitzone</h2><p class="text-body-secondary mb-0">Europe/Zurich · Oberfläche Deutsch (Schweiz)</p></div></section>
        </div>
    </div>
{% endblock %}

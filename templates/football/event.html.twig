{% extends 'base.html.twig' %}
{% macro category_fields(c) %}
<div class="col-md-3"><label class="form-label">Name<input class="form-control" name="name" value="{{ c.name|default('') }}" required></label></div>
<div class="col-md-2"><label class="form-label">Alter von<input class="form-control" type="number" min="0" name="age_min" value="{{ c.age_min|default('') }}"></label></div>
<div class="col-md-2"><label class="form-label">Alter bis<input class="form-control" type="number" min="0" name="age_max" value="{{ c.age_max|default('') }}"></label></div>
<div class="col-md-2"><label class="form-label">Wertung<select class="form-select" name="gender">{% for value,label in {'male':'Männlich','female':'Weiblich','mixed':'Mixed','open':'Offen'} %}<option value="{{ value }}" {{ c.gender|default('open')==value?'selected' }}>{{ label }}</option>{% endfor %}</select></label></div>
<div class="col-md-2"><label class="form-label">Max. Kader<input class="form-control" type="number" min="1" name="max_roster_size" value="{{ c.max_roster_size|default(15) }}" required></label></div>
<div class="col-md-2"><label class="form-label">Auf dem Feld<input class="form-control" type="number" min="1" name="players_on_field" value="{{ c.players_on_field|default(7) }}" required></label></div>
<div class="col-md-2"><label class="form-label">Spielminuten<input class="form-control" type="number" min="1" name="match_minutes" value="{{ c.match_minutes|default(15) }}" required></label></div>
<div class="col-md-2"><label class="form-label">Mindestpause<input class="form-control" type="number" min="0" name="min_break_minutes" value="{{ c.min_break_minutes|default(15) }}" required></label></div>
<div class="col-md-2"><label class="form-label">Verlängerung<input class="form-control" type="number" min="0" name="overtime_minutes" value="{{ c.overtime_minutes|default(5) }}" required></label></div>
<div class="col-md-2"><label class="form-label">Max. Gruppengrösse<input class="form-control" type="number" min="2" max="20" name="group_size" value="{{ c.group_size|default(4) }}" required></label></div>
<div class="col-md-3"><label class="form-label">Finalmodus<select class="form-select" name="tournament_mode">{% for value,label in {'final_only':'Nur Final','semifinal_final':'Halbfinal + Final','quarterfinal_semifinal_final':'Viertel- + Halbfinal + Final'} %}<option value="{{ value }}" {{ c.tournament_mode|default('semifinal_final')==value?'selected' }}>{{ label }}</option>{% endfor %}</select></label></div>
<div class="col-md-3"><label class="form-label">K.-o.-Unentschieden<select class="form-select" name="knockout_draw_mode"><option value="penalties" {{ c.knockout_draw_mode|default('penalties')=='penalties'?'selected' }}>Direkt Penalty</option><option value="overtime_penalties" {{ c.knockout_draw_mode|default('penalties')=='overtime_penalties'?'selected' }}>Verlängerung + Penalty</option></select></label></div>
<div class="col-md-2"><label class="form-label">Gruppensieger<input class="form-control" type="number" min="0" name="qualify_winners" value="{{ c.qualify_group_winners|default(1) }}"></label></div>
<div class="col-md-2"><label class="form-label">Gruppenzweite<input class="form-control" type="number" min="0" name="qualify_runners_up" value="{{ c.qualify_group_runners_up|default(1) }}"></label></div>
<div class="col-md-2"><label class="form-label">Beste Dritte<input class="form-control" type="number" min="0" name="qualify_best_thirds" value="{{ c.qualify_best_thirds|default(0) }}"></label></div>
<div class="col-md-3"><label class="form-check"><input class="form-check-input" type="checkbox" name="third_place" value="1" {{ c.third_place_enabled|default(false)?'checked' }}> Spiel um Platz 3</label></div>
<div class="col-md-4"><label class="form-check"><input class="form-check-input" type="checkbox" name="exclude_last" value="1" {{ c.exclude_last_for_cross_group|default(false)?'checked' }}> Letzten bei Gruppenvergleich herausrechnen</label></div>
{% endmacro %}
{% block title %}Fussballmodul · {{ football.event.name }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/assets/css/football.css">{% endblock %}
{% block javascripts %}<script src="/assets/js/football.js" defer></script>{% endblock %}
{% block body %}
<div data-football-revision="{{ football.revision }}" data-football-revision-url="{{ path('football_revision',{slug:tenant.slug,id:football.event.public_id}) }}">
<div class="d-flex justify-content-between mb-4"><div><p class="eyebrow">Fussballturnier</p><h1 class="h2">{{ football.event.name }}</h1><p><span class="badge text-bg-secondary">Spielplan: {{ football.settings.schedule_state }}</span> <span class="badge text-bg-secondary">Ranglisten: {{ football.settings.ranking_state }}</span></p></div><a href="{{ path('tenant_event',{slug:tenant.slug,id:football.event.public_id}) }}">Veranstaltung</a></div>
<div class="alert alert-warning d-none" data-football-stale>Ein anderer Arbeitsplatz hat Turnierdaten geändert. Bitte neu laden, bevor du speicherst.</div>
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}

{% if football.capabilities.manage %}
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Turnierkonfiguration</h2><form method="post" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="configure"><input type="hidden" name="lock_version" value="{{ football.settings.lock_version }}"><div class="col"><label class="form-label">Sieg<input class="form-control" type="number" min="0" name="points_win" value="{{ football.settings.points_win }}"></label></div><div class="col"><label class="form-label">Remis<input class="form-control" type="number" min="0" name="points_draw" value="{{ football.settings.points_draw }}"></label></div><div class="col"><label class="form-label">Niederlage<input class="form-control" type="number" min="0" name="points_loss" value="{{ football.settings.points_loss }}"></label></div><div class="col"><label class="form-label">Forfait Sieger<input class="form-control" type="number" min="0" name="forfait_win" value="{{ football.settings.forfait_goals_winner }}"></label></div><div class="col"><label class="form-label">Forfait Verlierer<input class="form-control" type="number" min="0" name="forfait_loss" value="{{ football.settings.forfait_goals_loser }}"></label></div><div class="col-md-3"><label class="form-label">Planungsstrategie<select class="form-select" name="strategy"><option value="field_utilization" {{ football.settings.scheduling_strategy=='field_utilization'?'selected' }}>Feldnutzung optimiert</option><option value="compact" {{ football.settings.scheduling_strategy=='compact'?'selected' }}>Kompakt</option><option value="balanced" {{ football.settings.scheduling_strategy=='balanced'?'selected' }}>Ausgeglichen</option></select></label></div><div class="col-auto align-self-end"><button class="btn btn-primary">Speichern</button></div></form></div></div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">Kategorien</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="swiss_defaults"><button class="btn btn-outline-secondary btn-sm">SFV-Ausgangsvorlagen anlegen</button></form></div><details class="mb-3"><summary>Freie Kategorie anlegen</summary><form method="post" class="row g-2 mt-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="category">{{ _self.category_fields({}) }}<div><button class="btn btn-primary">Kategorie anlegen</button></div></form></details>{% for c in football.categories %}<details class="border-top py-2"><summary>{{ c.name }} · {{ c.gender }} · {{ c.players_on_field }} auf Feld · {{ c.match_minutes }} Min.</summary><form method="post" class="row g-2 mt-2"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="category_update"><input type="hidden" name="category_id" value="{{ c.public_id }}"><input type="hidden" name="lock_version" value="{{ c.lock_version }}">{{ _self.category_fields(c) }}<div><button class="btn btn-outline-primary">Kategorie ändern</button></div></form><form method="post" class="mt-2"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="groups"><input type="hidden" name="category" value="{{ c.public_id }}"><button class="btn btn-sm btn-outline-secondary">Gruppen automatisch erzeugen</button></form></details>{% endfor %}</div></div>

<div class="row g-4 mb-4"><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Teams, Kategorien und Gruppen</h2><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Nr. / Team / Kader</th><th>Kategorie</th><th>Gruppe</th></tr></thead><tbody>{% for t in football.teams %}<tr class="{{ t.withdrawn_at?'table-secondary' }}"><td><form method="post" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="team_update"><input type="hidden" name="team" value="{{ t.public_id }}"><input type="hidden" name="lock_version" value="{{ t.team_lock_version }}"><input class="form-control form-control-sm team-number-input" type="number" min="1" name="team_number" value="{{ t.team_number }}" required><input class="form-control form-control-sm" name="name" value="{{ t.name }}" required><button class="btn btn-sm btn-outline-primary">OK</button></form><span class="small text-secondary">{{ t.roster_size }} Spieler{% if t.withdrawn_at %} · zurückgezogen{% endif %}</span></td><td><form method="post" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="team_category"><input type="hidden" name="team" value="{{ t.public_id }}"><select class="form-select form-select-sm" name="category">{% for c in football.categories %}<option value="{{ c.public_id }}" {{ t.category_id==c.id?'selected' }}>{{ c.name }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-primary">OK</button></form></td><td>{% if t.category_id %}<form method="post" class="d-flex gap-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="team_group"><input type="hidden" name="team" value="{{ t.public_id }}"><select class="form-select form-select-sm" name="group">{% for g in football.groups %}{% if g.category_id==t.category_id %}<option value="{{ g.public_id }}" {{ t.group_id==g.id?'selected' }}>{{ g.name }}</option>{% endif %}{% endfor %}</select><button class="btn btn-sm btn-outline-primary">OK</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="3">Teams zuerst unter „Teilnehmer &amp; Teams“ erfassen.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Spielfelder und Zeiten</h2><form method="post" class="d-flex gap-2 mb-3"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="field"><input class="form-control" name="name" placeholder="Feldname" required><button class="btn btn-primary">Anlegen</button></form>{% for f in football.fields %}<h3 class="h6">{{ f.name }}</h3><form method="post" class="row g-1 mb-2"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="period"><input type="hidden" name="field" value="{{ f.public_id }}"><div class="col-3"><select class="form-select form-select-sm" name="period_type"><option value="available">Verfügbar</option><option value="blocked">Gesperrt</option></select></div><div class="col"><input class="form-control form-control-sm" type="datetime-local" name="starts_at" required></div><div class="col"><input class="form-control form-control-sm" type="datetime-local" name="ends_at" required></div><div class="col"><input class="form-control form-control-sm" name="reason" placeholder="Grund"></div><div class="col-auto"><button class="btn btn-sm btn-outline-primary">+</button></div></form>{% endfor %}<ul class="small">{% for p in football.periods %}<li>{{ p.field_name }}: {{ p.period_type }} · {{ p.starts_at|date('d.m.Y H:i') }}–{{ p.ends_at|date('H:i') }} {{ p.reason }}</li>{% endfor %}</ul></div></div></div></div>

<div class="d-flex flex-wrap gap-2 mb-4"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="schedule"><button class="btn btn-primary">Spielplan erzeugen</button></form>{% for c in football.categories %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="finals"><input type="hidden" name="category" value="{{ c.public_id }}"><button class="btn btn-outline-primary">Finalrunde {{ c.name }} erzeugen</button></form>{% if c.qualify_best_thirds > 0 %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="cross_group_lot"><input type="hidden" name="category" value="{{ c.public_id }}"><button class="btn btn-outline-warning">Los beste Dritte · {{ c.name }}</button></form>{% endif %}{% endfor %}</div>
{% endif %}

<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Spielplan und Resultate</h2><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Zeit/Feld</th><th>Phase</th><th>Begegnung</th><th>Resultat</th>{% if football.capabilities.manage %}<th>Verschieben</th>{% endif %}</tr></thead><tbody>{% for m in football.matches %}<tr><td>{{ m.scheduled_start ? m.scheduled_start|date('d.m. H:i') : 'nicht angesetzt' }}<br>{{ m.field_name|default('ohne Feld') }}</td><td>{{ m.category_name }}<br>{{ m.group_name|default(m.stage) }}</td><td>{{ m.home_name|default('offen') }} – {{ m.away_name|default('offen') }}</td><td>{% if football.capabilities.data_entry and m.home_team_id and m.away_team_id %}<form method="post" class="d-flex flex-wrap gap-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="result"><input type="hidden" name="match" value="{{ m.public_id }}"><input type="hidden" name="lock_version" value="{{ m.lock_version }}"><input class="form-control form-control-sm score-input" type="number" min="0" max="99" name="home_goals" value="{{ m.home_goals }}"><span>:</span><input class="form-control form-control-sm score-input" type="number" min="0" max="99" name="away_goals" value="{{ m.away_goals }}"><input class="form-control form-control-sm score-input" type="number" min="0" name="home_penalties" value="{{ m.home_penalties }}" title="Penalty Heim"><input class="form-control form-control-sm score-input" type="number" min="0" name="away_penalties" value="{{ m.away_penalties }}" title="Penalty Gast"><select class="form-select form-select-sm forfait-select" name="forfait"><option value="">regulär</option><option value="home">Forfait Heim</option><option value="away">Forfait Gast</option></select><input class="form-control form-control-sm card-input" type="number" min="0" name="home_yellow" value="{{ m.home_yellow }}" title="Gelb Heim"><input class="form-control form-control-sm card-input" type="number" min="0" name="away_yellow" value="{{ m.away_yellow }}" title="Gelb Gast"><input class="form-control form-control-sm card-input" type="number" min="0" name="home_red" value="{{ m.home_red }}" title="Rot Heim"><input class="form-control form-control-sm card-input" type="number" min="0" name="away_red" value="{{ m.away_red }}" title="Rot Gast"><button class="btn btn-sm btn-primary">Speichern</button></form>{% else %}{% if m.status=='played' %}{{ m.home_goals }}:{{ m.away_goals }}{% if m.home_penalties is not null %}, {{ m.home_penalties }}:{{ m.away_penalties }} n.P.{% endif %}{% else %}{{ m.status }}{% endif %}{% endif %}</td>{% if football.capabilities.manage %}<td><form method="post" class="d-flex flex-wrap gap-1"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="move"><input type="hidden" name="match" value="{{ m.public_id }}"><input type="hidden" name="lock_version" value="{{ m.lock_version }}"><select class="form-select form-select-sm" name="field">{% for f in football.fields %}<option value="{{ f.public_id }}" {{ m.field_id==f.id?'selected' }}>{{ f.name }}</option>{% endfor %}</select><input class="form-control form-control-sm" type="datetime-local" name="starts_at" value="{{ m.scheduled_start ? m.scheduled_start|date('Y-m-d\\TH:i') : '' }}" required><label class="small"><input type="checkbox" name="acknowledge" value="1"> Warnung bestätigen</label><button class="btn btn-sm btn-outline-primary">Verschieben</button></form></td>{% endif %}</tr>{% else %}<tr><td colspan="5">Noch kein Spielplan verfügbar.</td></tr>{% endfor %}</tbody></table></div></div></div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Gruppenranglisten</h2>{% for group in football.standings %}<h3 class="h6 mt-3">{{ group.category_name }} · {{ group.group_name }}</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Rang</th><th>Team</th><th>Sp.</th><th>S/U/N</th><th>Tore</th><th>Diff.</th><th>Punkte</th><th>Fairplay</th></tr></thead><tbody>{% set needs_lot=false %}{% for row in group.rows %}{% if row.lot_required %}{% set needs_lot=true %}{% endif %}<tr class="{{ row.lot_required?'table-warning' }}"><td>{{ row.position }}</td><td>{{ row.team_name }}</td><td>{{ row.played }}</td><td>{{ row.wins }}/{{ row.draws }}/{{ row.losses }}</td><td>{{ row.goals_for }}:{{ row.goals_against }}</td><td>{{ row.goal_difference }}</td><td>{{ row.points }}</td><td>{{ row.fairplay }}</td></tr>{% endfor %}</tbody></table></div>{% if needs_lot and football.capabilities.manage %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="lot"><input type="hidden" name="group" value="{{ group.group_id }}"><button class="btn btn-sm btn-warning">Losentscheid auslösen</button></form>{% endif %}{% endfor %}</div></div>

<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Schlussranglisten</h2>{% for c in football.categories %}{% set rows=football.final_rankings[c.public_id]|default([]) %}{% if rows %}<h3 class="h6">{{ c.name }}</h3><ol>{% for row in rows %}<li value="{{ row.position }}">{{ row.team_name }}</li>{% endfor %}</ol>{% endif %}{% endfor %}</div></div>

{% if football.capabilities.manage %}<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Mannschaftsausfall</h2><form method="post" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="withdraw"><div class="col-12"><select class="form-select" name="team">{% for t in football.teams %}{% if not t.withdrawn_at %}<option value="{{ t.public_id }}">{{ t.team_number }} · {{ t.name }}</option>{% endif %}{% endfor %}</select></div><div class="col"><select class="form-select" name="upcoming_action"><option value="cancel">Offene Spiele absagen</option><option value="void">Offene Spiele streichen</option></select></div><div class="col"><select class="form-select" name="played_action"><option value="keep">Resultate behalten</option><option value="remove">Resultate aus Wertung</option></select></div><div class="col-12"><input class="form-control" name="reason" placeholder="Begründung" required></div><div><button class="btn btn-outline-danger">Team zurückziehen</button></div></form></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5">Freigaben</h2>{% for type,label in {'schedule':'Spielplan','rankings':'Ranglisten'} %}<div class="d-flex gap-2 mb-2"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="publish"><input type="hidden" name="type" value="{{ type }}"><button class="btn btn-primary">{{ label }} freigeben</button></form><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('football_'~football.event.public_id) }}"><input type="hidden" name="action" value="unpublish"><input type="hidden" name="type" value="{{ type }}"><button class="btn btn-outline-secondary">Freigabe zurücknehmen</button></form>{% if football.publications[type]|default(false) %}<span>Version {{ football.publications[type].version }}</span>{% endif %}</div>{% endfor %}</div></div></div></div>{% endif %}

<div class="d-flex flex-wrap gap-2">{% for document,label in {'schedule':'Spielplan gesamt','schedule_category':'Nach Kategorie','schedule_field':'Nach Spielfeld','schedule_time':'Nach Zeit','standings':'Gruppenranglisten','finals':'Finalrunde','final_rankings':'Schlussranglisten'} %}<a class="btn btn-outline-secondary" href="{{ path('football_pdf',{slug:tenant.slug,id:football.event.public_id,document:document}) }}">{{ label }} PDF</a>{% endfor %}</div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Geplante Wartung{% endblock %}
{% block shell %}<main id="main-content" class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card border-warning shadow-sm"><div class="card-body p-4 p-md-5"><p class="eyebrow">Systemwartung</p><h1 class="h2">Wir sind bald wieder da.</h1><p class="lead">{{ maintenance.message }}</p><p class="text-body-secondary mb-0">Voraussichtliches Ende: {{ maintenance.expected_end_at|date('d.m.Y H:i', 'Europe/Zurich') }} Uhr</p></div></div></div></div></main>{% endblock %}

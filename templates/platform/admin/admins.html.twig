{% extends 'platform/base.html.twig' %}{% block title %}Plattformadmins{% endblock %}{% block platform_body %}<h1 class="h2">Plattformadmins</h1>{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5">Admin einladen</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_admin_invite') }}"><label class="form-label" for="email">E-Mail</label><input class="form-control mb-3" id="email" name="email" type="email" required><button class="btn btn-dark" type="submit">Einladen</button></form></div></div></div><div class="col-lg-8"><div class="card"><div class="table-responsive"><table class="table mb-0 align-middle"><thead><tr><th>Name</th><th>Status</th><th>2FA</th><th></th></tr></thead><tbody>{% for admin in admins %}<tr><td>{{ admin.displayName }}<small class="d-block text-body-secondary">{{ admin.email }}</small></td><td>{{ not admin.emailConfirmed ? 'Eingeladen' : (admin.active ? 'Aktiv' : 'Deaktiviert') }}</td><td>{{ admin.twoFactor ? 'Aktiv' : 'Ausstehend' }}</td><td class="text-end"><form class="d-inline" method="post" action="{{ path('platform_admin_action', {publicId: admin.publicId, action: admin.active ? 'deactivate' : 'activate'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_admin_action_' ~ admin.publicId) }}"><button class="btn btn-sm btn-outline-secondary" type="submit">{{ admin.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form> <form class="d-inline" method="post" action="{{ path('platform_admin_action', {publicId: admin.publicId, action: 'unlock'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_admin_action_' ~ admin.publicId) }}"><button class="btn btn-sm btn-outline-secondary" type="submit">Entsperren</button></form> <a class="btn btn-sm btn-outline-danger" href="{{ path('platform_admin_delete', {publicId: admin.publicId}) }}">Löschen</a></td></tr>{% endfor %}</tbody></table></div></div></div></div>{% endblock %}

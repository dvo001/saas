{% extends 'platform/base.html.twig' %}{% block title %}Plattform-Dashboard{% endblock %}{% block platform_body %}<div class="mb-4"><p class="eyebrow">Plattform</p><h1 class="h2">Dashboard</h1><p class="text-body-secondary">Angemeldet als {{ app.user.displayName }}</p></div><div class="row g-3">{% for label, value in {'Aktive Vereine': counts.active, 'Probeabos': counts.trial, 'Gesperrte Vereine': counts.suspended, 'Offene Registrierungen': counts.pending} %}<div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="display-6">{{ value }}</div><div class="text-body-secondary">{{ label }}</div></div></div></div>{% endfor %}</div>{% endblock %}

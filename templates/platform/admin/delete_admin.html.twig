{% extends 'platform/base.html.twig' %}
{% block title %}Plattformadmin löschen{% endblock %}
{% block platform_body %}<div class="row justify-content-center"><div class="col-lg-6"><p class="eyebrow">Sicherheitskritische Aktion</p><h1 class="h2">{{ target.displayName }} löschen</h1><p>Das Konto wird deaktiviert und personenbezogen anonymisiert. Der letzte verbleibende Plattformadmin ist geschützt.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<div class="card border-danger"><div class="card-body"><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_admin_delete_' ~ target.publicId) }}"><label class="form-label" for="password">Eigenes aktuelles Passwort zur Bestätigung</label><input class="form-control mb-3" type="password" id="password" name="password" autocomplete="current-password" required><button class="btn btn-danger" type="submit">Endgültig anonymisieren</button> <a class="btn btn-outline-secondary" href="{{ path('platform_admins') }}">Abbrechen</a></form></div></div></div></div>{% endblock %}

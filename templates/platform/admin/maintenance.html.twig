{% extends 'platform/base.html.twig' %}
{% block title %}Wartung · Plattformadministration{% endblock %}
{% block platform_body %}
<div class="mb-4"><p class="eyebrow">Betrieb</p><h1 class="h2">Wartung</h1><p class="text-body-secondary">Vereinszugriffe erhalten während eines aktiven Fensters eine 503-Wartungsseite; die Plattformadministration bleibt erreichbar.</p></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
{% if active %}<div class="alert alert-warning"><strong>Wartung aktiv</strong> bis {{ active.expected_end_at|date('d.m.Y H:i', 'Europe/Zurich') }} Uhr: {{ active.message }} <form class="d-inline ms-2" method="post" action="{{ path('platform_maintenance_cancel', {publicId: active.public_id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('cancel_maintenance_' ~ active.public_id) }}"><button class="btn btn-sm btn-outline-dark" type="submit">Jetzt beenden</button></form></div>{% elseif next %}<div class="alert alert-info"><strong>Nächste Wartung:</strong> {{ next.starts_at|date('d.m.Y H:i', 'Europe/Zurich') }}–{{ next.expected_end_at|date('H:i', 'Europe/Zurich') }} Uhr. <form class="d-inline ms-2" method="post" action="{{ path('platform_maintenance_cancel', {publicId: next.public_id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('cancel_maintenance_' ~ next.public_id) }}"><button class="btn btn-sm btn-outline-dark" type="submit">Absagen</button></form></div>{% endif %}
<div class="row g-4"><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Wartungsfenster anlegen</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('schedule_maintenance') }}"><div class="mb-3"><label class="form-label" for="starts_at">Start (Europe/Zurich)</label><input class="form-control" type="datetime-local" id="starts_at" name="starts_at"></div><div class="mb-3"><label class="form-label" for="duration">Erwartete Dauer in Minuten</label><input class="form-control" type="number" min="5" max="1440" id="duration" name="duration" value="60" required></div><div class="mb-3"><label class="form-label" for="message">Text für Vereinsbenutzer</label><textarea class="form-control" id="message" name="message" maxlength="1000" required></textarea></div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="immediate" name="immediate" value="1"><label class="form-check-label" for="immediate">Sofortige Notfallwartung starten</label></div><button class="btn btn-warning" type="submit">Wartung speichern</button></form></div></div></div><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Historie</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Start</th><th>Ende</th><th>Status</th><th>Erstellt von</th></tr></thead><tbody>{% for item in history %}<tr><td>{{ item.starts_at|date('d.m.Y H:i', 'Europe/Zurich') }}</td><td>{{ item.expected_end_at|date('d.m.Y H:i', 'Europe/Zurich') }}</td><td>{{ item.cancelled_at ? 'Abgesagt' : 'Geplant/abgeschlossen' }}</td><td>{{ item.display_name ?: item.email }}</td></tr>{% else %}<tr><td colspan="4" class="text-body-secondary">Noch keine Einträge.</td></tr>{% endfor %}</tbody></table></div></div></div></div>
{% endblock %}

{% extends 'platform/base.html.twig' %}
{% block title %}Einstellungen · Plattformadministration{% endblock %}
{% block platform_body %}
<div class="mb-4"><p class="eyebrow">Plattform</p><h1 class="h2">Zentrale Einstellungen</h1><p class="text-body-secondary">Änderungen werden als neue, nachvollziehbare Version gespeichert.</p><a class="btn btn-outline-primary" href="{{ path('platform_event_templates') }}">Veranstaltungsvorlagen &amp; Modulstandards</a></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<div class="row g-4"><div class="col-xl-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_settings') }}">
<h2 class="h5">Plattform und Betreiber</h2><div class="mb-3"><label class="form-label" for="platform_name">Plattformname</label><input class="form-control" id="platform_name" name="platform_name" value="{{ platform_name }}" required></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="operator_name">Betreiber</label><input class="form-control" id="operator_name" name="operator_name" value="{{ operator.name|default('') }}"></div><div class="col-md-6 mb-3"><label class="form-label" for="operator_email">Betreiber-E-Mail</label><input class="form-control" type="email" id="operator_email" name="operator_email" value="{{ operator.email|default('') }}" required></div></div><div class="mb-3"><label class="form-label" for="operator_address">Adresse</label><textarea class="form-control" id="operator_address" name="operator_address">{{ operator.address|default('') }}</textarea></div><div class="row"><div class="col-md-8 mb-4"><label class="form-label" for="mail_sender">Systemabsender-E-Mail</label><input class="form-control" type="email" id="mail_sender" name="mail_sender" value="{{ mail_sender }}" required></div><div class="col-md-4 mb-4"><label class="form-label" for="logo_max_pixels">Max. Logo-Abmessung</label><input class="form-control" type="number" min="100" max="10000" id="logo_max_pixels" name="logo_max_pixels" value="{{ logo_max_pixels }}"></div></div>
<h2 class="h5">Cronintervalle</h2><div class="row"><div class="col-md-4 mb-3"><label class="form-label" for="dispatcher_minutes">Dispatcher (Min.)</label><input class="form-control" type="number" min="1" max="60" id="dispatcher_minutes" name="dispatcher_minutes" value="{{ cron.dispatcher_minutes|default(5) }}"></div><div class="col-md-4 mb-3"><label class="form-label" for="mail_minutes">Mail (Min.)</label><input class="form-control" type="number" min="1" max="60" id="mail_minutes" name="mail_minutes" value="{{ cron.mail_minutes|default(5) }}"></div><div class="col-md-4 mb-3"><label class="form-label" for="cleanup_hours">Bereinigung (Std.)</label><input class="form-control" type="number" min="1" max="168" id="cleanup_hours" name="cleanup_hours" value="{{ cron.cleanup_hours|default(24) }}"></div></div>
<hr class="my-4"><h2 class="h5">QR-Rechnung und MwSt.</h2><div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="creditor_name">Zahlungsempfänger</label><input class="form-control" id="creditor_name" name="creditor_name" value="{{ creditor.name|default('') }}"></div><div class="col-md-6 mb-3"><label class="form-label" for="creditor_iban">IBAN / QR-IBAN</label><input class="form-control" id="creditor_iban" name="creditor_iban" value="{{ creditor.iban|default('') }}"></div><div class="col-md-6 mb-3"><label class="form-label" for="creditor_street">Strasse</label><input class="form-control" id="creditor_street" name="creditor_street" value="{{ creditor.street|default('') }}"></div><div class="col-md-2 mb-3"><label class="form-label" for="creditor_postal_code">PLZ</label><input class="form-control" id="creditor_postal_code" name="creditor_postal_code" value="{{ creditor.postal_code|default('') }}"></div><div class="col-md-4 mb-3"><label class="form-label" for="creditor_city">Ort</label><input class="form-control" id="creditor_city" name="creditor_city" value="{{ creditor.city|default('') }}"></div><div class="col-md-3 mb-3"><label class="form-label" for="creditor_country_code">Land</label><input class="form-control" id="creditor_country_code" name="creditor_country_code" value="{{ creditor.country_code|default('CH') }}" maxlength="2"></div><div class="col-md-4 mb-3"><label class="form-label" for="vat_basis_points">MwSt. (Basispunkte)</label><input class="form-control" type="number" min="0" max="10000" id="vat_basis_points" name="vat_basis_points" value="{{ vat_basis_points }}"><div class="form-text">810 entspricht 8.10 %.</div></div></div><button class="btn btn-dark" type="submit">Version speichern</button></form></div></div></div>
<div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Letzte Versionen</h2></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Schlüssel</th><th>Gültig ab</th><th>Admin</th></tr></thead><tbody>{% for item in history %}<tr><td><code>{{ item.setting_key }}</code></td><td>{{ item.valid_from|date('d.m.Y H:i:s', 'Europe/Zurich') }}</td><td>{{ item.display_name ?: item.email ?: 'Installation' }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
{% endblock %}

{% extends 'platform/base.html.twig' %}
{% block title %}Systemstatus · Plattformadministration{% endblock %}
{% block platform_body %}
<div class="mb-4"><p class="eyebrow">Betrieb</p><h1 class="h2">Systemstatus und Cronjobs</h1></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Plattform</h2><span class="badge text-bg-{{ status.overall == 'operational' ? 'success' : (status.overall == 'maintenance' ? 'warning' : 'danger') }}">{{ status.overall }}</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Mailversand</h2><span class="badge text-bg-{{ status.mail == 'configured' ? 'success' : 'secondary' }}">{{ status.mail }}</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Wartung</h2><span class="badge text-bg-{{ status.maintenance ? 'warning' : 'success' }}">{{ status.maintenance ? 'aktiv' : (status.next_maintenance ? 'geplant' : 'keine') }}</span></div></div></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Letzter Lauf je Cronjob</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Job</th><th>Start</th><th>Ende</th><th>Status</th><th>Fehlerreferenz</th></tr></thead><tbody>{% for run in status.cron_runs %}<tr><td>{{ run.job_name }}</td><td>{{ run.started_at|date('d.m.Y H:i:s', 'Europe/Zurich') }}</td><td>{{ run.finished_at ? run.finished_at|date('d.m.Y H:i:s', 'Europe/Zurich') : 'läuft' }}</td><td><span class="badge text-bg-{{ run.status == 'success' ? 'success' : (run.status == 'running' ? 'info' : 'danger') }}">{{ run.status }}</span></td><td>{{ run.error_reference ?: '–' }}</td></tr>{% else %}<tr><td colspan="5" class="text-body-secondary">Noch keine überwachten Cronläufe vorhanden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}

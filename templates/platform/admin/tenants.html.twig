{% extends 'platform/base.html.twig' %}
{% block title %}Vereine · Plattformadministration{% endblock %}
{% block platform_body %}
<div class="mb-4"><p class="eyebrow">Plattform</p><h1 class="h2">Vereine</h1><p class="text-body-secondary">Supportzugriffe sind zeitlich begrenzt und werden in beiden Audit-Kontexten protokolliert.</p></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Verein</th><th>Status</th><th>Testmodul</th><th>Support</th><th>Aktionen</th></tr></thead><tbody>
{% for tenant in tenants %}<tr><td><strong>{{ tenant.name }}</strong><small class="d-block text-body-secondary">/v/{{ tenant.slug }}</small></td><td>{{ tenant.status.value }}</td><td>{{ tenant.trialModule.label }}</td><td>{{ tenant.supportImpersonationEnabled ? 'Freigegeben' : 'Deaktiviert' }}</td><td><div class="d-flex flex-column align-items-start gap-2">{% if tenant.status.value == 'pending_confirmation' %}<form method="post" action="{{ path('platform_tenant_activate', {publicId: tenant.publicId}) }}" class="d-flex flex-column gap-2"><input type="hidden" name="_csrf_token" value="{{ csrf_token('tenant_activate_' ~ tenant.publicId) }}"><label class="visually-hidden" for="reason-{{ tenant.publicId }}">Begründung</label><input class="form-control form-control-sm" id="reason-{{ tenant.publicId }}" name="reason" minlength="10" maxlength="500" placeholder="Begründung der Freischaltung" required><button class="btn btn-sm btn-success" type="submit">Registrierung freischalten</button></form>{% endif %}{% if tenant.supportImpersonationEnabled %}<a class="btn btn-sm btn-outline-primary" href="{{ path('platform_tenant_support', {publicId: tenant.publicId}) }}">Supportmodus starten</a>{% elseif tenant.status.value != 'pending_confirmation' %}<span class="text-body-secondary">Nicht verfügbar</span>{% endif %}</div></td></tr>{% else %}<tr><td colspan="5" class="text-center py-4 text-body-secondary">Noch keine Vereine vorhanden.</td></tr>{% endfor %}
</tbody></table></div></div>
{% endblock %}

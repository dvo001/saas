{% extends 'base.html.twig' %}{% block title %}Plattform-Einladung{% endblock %}{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="h3">Plattform-Einladung annehmen</h1><p>Nach der Anmeldung muss obligatorisch 2FA eingerichtet werden.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_invitation_' ~ token) }}"><label class="form-label" for="display_name">Name</label><input class="form-control mb-3" id="display_name" name="display_name" required><label class="form-label" for="password">Passwort</label><input class="form-control mb-3" id="password" name="password" type="password" minlength="12" required><button class="btn btn-dark" type="submit">Konto aktivieren</button></form></div></div></main>{% endblock %}

{% extends 'base.html.twig' %}{% block title %}Plattformadministration{% endblock %}{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><p class="eyebrow">Getrennter Sicherheitsbereich</p><h1 class="h3">Plattformadministration</h1>{% if app.request.query.get('expired') %}<div class="alert alert-info">Die Sitzung ist abgelaufen.</div>{% endif %}{% if app.request.query.get('invited') %}<div class="alert alert-success">Das Konto wurde aktiviert. Melden Sie sich an und richten Sie 2FA ein.</div>{% endif %}{% if authentication_error %}<div class="alert alert-danger">{{ authentication_error.messageKey|trans(authentication_error.messageData, 'security') }}</div>{% endif %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_login') }}"><div class="mb-3"><label class="form-label" for="email">E-Mail-Adresse</label><input class="form-control" id="email" name="email" type="email" value="{{ last_username }}" autocomplete="username" required autofocus></div><div class="mb-3"><label class="form-label" for="password">Passwort</label><input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn btn-dark w-100" type="submit">Sicher anmelden</button></form></div></div></main>{% endblock %}

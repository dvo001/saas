{% extends 'base.html.twig' %}{% block title %}Plattform-2FA einrichten{% endblock %}{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-danger shadow-sm"><div class="card-body p-4 p-md-5"><p class="eyebrow">Obligatorischer Kontoschutz</p><h1 class="h3">2FA für Plattformadmin einrichten</h1><p class="text-body-secondary">Scannen Sie den QR-Code mit Ihrer Authenticator-App.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<div class="text-center mb-4"><img src="{{ qr_code_data_uri }}" width="280" height="280" alt="QR-Code zur Einrichtung der Zwei-Faktor-Authentisierung"></div><dl><dt>Schlüssel</dt><dd><code class="user-select-all">{{ secret }}</code></dd><dt>Einrichtungs-URI</dt><dd class="text-break"><code class="user-select-all">{{ uri }}</code></dd></dl><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('platform_totp_setup') }}"><label class="form-label" for="code">6-stelliger Code</label><input class="form-control mb-3" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" required autofocus><button class="btn btn-dark" type="submit">2FA aktivieren</button></form></div></div></main>{% endblock %}

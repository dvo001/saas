{% extends 'platform/base.html.twig' %}{% block title %}Gutscheine und Kulanz{% endblock %}{% block platform_body %}<div class="mb-4"><p class="eyebrow">Billing</p><h1 class="h2">Gutscheine und Kulanz</h1></div>{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}<div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Gutschein erzeugen</h2><form method="post" action="{{ path('platform_billing_coupon') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_coupon') }}"><select class="form-select mb-3" name="coupon_type"><option value="first_booking">Erstbuchung</option><option value="compassion">Kulanz</option></select><label class="form-label">Rabatt (Basispunkte)</label><input class="form-control mb-3" type="number" min="1" max="10000" name="percentage_basis_points" required><label class="form-label">Verein (für Kulanz)</label><select class="form-select mb-3" name="tenant"><option value="">–</option>{% for t in tenants %}<option value="{{ t.public_id }}">{{ t.name }}</option>{% endfor %}</select><label class="form-label">Modulbereich (optional)</label>{% for m in modules %}<div class="form-check"><input class="form-check-input" type="checkbox" name="modules[]" value="{{ m.code }}" id="c{{ loop.index }}"><label class="form-check-label" for="c{{ loop.index }}">{{ m.name }}</label></div>{% endfor %}<label class="form-label mt-3">Gültig bis</label><input class="form-control mb-3" type="datetime-local" name="valid_until"><button class="btn btn-dark">Erzeugen</button></form></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Kulanzverlängerung</h2><form method="post" action="{{ path('platform_billing_extension') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_extension') }}"><label class="form-label">Verein</label><select class="form-select mb-3" name="tenant" required>{% for t in tenants %}<option value="{{ t.public_id }}">{{ t.name }}</option>{% endfor %}</select><label class="form-label">Nur Modul (optional)</label><select class="form-select mb-3" name="module"><option value="">Gesamtes Abo</option>{% for m in modules %}<option value="{{ m.code }}">{{ m.name }}</option>{% endfor %}</select><label class="form-label">Tage</label><input class="form-control mb-3" type="number" min="1" max="365" name="days" required><label class="form-label">Pflichtbegründung</label><textarea class="form-control mb-3" name="reason" required></textarea><button class="btn btn-dark">Verlängern</button></form></div></div></div></div><div class="card border-0 shadow-sm mt-4"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Typ</th><th>Rabatt</th><th>Verein</th><th>Status</th></tr></thead><tbody>{% for c in coupons %}<tr><td>{{ c.coupon_type }}</td><td>{{ (c.percentage_basis_points / 100)|number_format(2) }} %</td><td>{{ c.tenant_name ?: 'frei' }}</td><td>{{ c.redeemed_at ? 'eingelöst' : 'offen' }}</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}

{% extends 'platform/base.html.twig' %}{% block title %}Rechnungen · Plattformadministration{% endblock %}{% block platform_body %}<div class="mb-4"><p class="eyebrow">Billing</p><h1 class="h2">Rechnungen und Zahlungen</h1></div>{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Buchhaltungs-CSV</h2><form method="post" action="{{ path('platform_accounting_export') }}" class="row g-3"><input type="hidden" name="_csrf_token" value="{{ csrf_token('accounting_export') }}"><div class="col-md-2"><label class="form-label">Zeitraum</label><select class="form-select" name="period"><option value="month">Monat</option><option value="quarter">Quartal</option><option value="year">Jahr</option><option value="custom">Freier Zeitraum</option></select></div><div class="col-md-2"><label class="form-label">Monat</label><input class="form-control" type="month" name="month" value="{{ 'now'|date('Y-m') }}"></div><div class="col-md-2"><label class="form-label">Jahr</label><input class="form-control" type="number" name="year" min="2000" max="2200" value="{{ 'now'|date('Y') }}"></div><div class="col-md-2"><label class="form-label">Quartal</label><select class="form-select" name="quarter"><option value="1">Q1</option><option value="2">Q2</option><option value="3">Q3</option><option value="4">Q4</option></select></div><div class="col-md-2"><label class="form-label">Von</label><input class="form-control" type="date" name="date_from" value="{{ 'now'|date('Y-01-01') }}"></div><div class="col-md-2"><label class="form-label">Bis</label><input class="form-control" type="date" name="date_to" value="{{ 'now'|date('Y-m-d') }}"></div><div class="col-12"><button class="btn btn-primary">CSV exportieren</button></div></form></div></div><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Rechnung</th><th>Verein</th><th>Status</th><th>Total</th><th>Fällig</th><th></th></tr></thead><tbody>{% for i in invoices %}<tr><td>{{ i.invoice_number }}</td><td>{{ i.tenant_name }}</td><td>{{ i.status }}</td><td>{{ i.currency }} {{ (i.total_minor / 100)|number_format(2, '.', "'") }}</td><td>{{ i.due_at|date('d.m.Y') }}</td><td>{% if i.status in ['open', 'overdue', 'dunning'] %}<form method="post" action="{{ path('platform_invoice_paid', {publicId: i.public_id}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('invoice_paid_' ~ i.public_id) }}"><button class="btn btn-sm btn-outline-success">Zahlung verbuchen</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="6">Noch keine Rechnungen.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}

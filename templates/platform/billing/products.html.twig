{% extends 'platform/base.html.twig' %}
{% block title %}Abos und Module · Plattformadministration{% endblock %}
{% block platform_body %}
<div class="d-flex flex-wrap justify-content-between gap-3 mb-4"><div><p class="eyebrow">Billing</p><h1 class="h2">Abos, Module und Preise</h1><p class="text-body-secondary">Preise werden ausschliesslich hier versioniert. Bereits laufende Abos referenzieren weiterhin ihre damalige Preisversion.</p></div><a class="btn btn-outline-secondary align-self-start" href="{{ path('platform_billing_administration') }}">Gutscheine &amp; Kulanz</a></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<form method="get" class="d-flex align-items-center gap-2 mb-3"><div class="form-check mb-0"><input class="form-check-input" type="checkbox" id="mit_deaktivierten" name="mit_deaktivierten" value="1"{% if include_inactive %} checked{% endif %}><label class="form-check-label" for="mit_deaktivierten">Mit deaktivierten</label></div><button class="btn btn-sm btn-outline-secondary" type="submit">Anzeige aktualisieren</button></form>
<div class="row g-4"><div class="col-xl-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Produkt anlegen</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_product_create') }}"><div class="mb-3"><label class="form-label" for="product_key">Stabiler Produktschlüssel</label><input class="form-control" id="product_key" name="product_key" placeholder="main.annual" required></div><div class="mb-3"><label class="form-label" for="name">Bezeichnung</label><input class="form-control" id="name" name="name" required></div><div class="mb-3"><label class="form-label" for="product_type">Typ</label><select class="form-select" id="product_type" name="product_type"><option value="main_subscription">Hauptabo</option><option value="sport_module">Sportmodul</option></select></div><div class="mb-3"><label class="form-label" for="module">Sportmodul (nur für Modultyp)</label><select class="form-select" id="module" name="module"><option value="">–</option>{% for module in modules %}<option value="{{ module.code }}">{{ module.name }} · {{ module.complexity }}</option>{% endfor %}</select></div><button class="btn btn-dark" type="submit">Produkt anlegen</button></form></div></div></div><div class="col-xl-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Produkt</th><th>Typ</th><th>Aktueller Preis</th><th>Neue Preisversion</th><th></th></tr></thead><tbody>{% for product in products %}<tr{% if not product.active %} class="table-secondary"{% endif %}><td><strong>{{ product.name }}</strong>{% if not product.active %} <span class="badge text-bg-secondary">Deaktiviert</span>{% endif %}<small class="d-block text-body-secondary"><code>{{ product.product_key }}</code>{% if product.module_code %} · {{ product.module_code }}{% endif %}</small></td><td>{{ product.product_type }}</td><td>{% if product.amount_minor is not null %}{{ product.currency }} {{ (product.amount_minor / 100)|number_format(2, '.', "'") }}<small class="d-block text-body-secondary">seit {{ product.valid_from|date('d.m.Y H:i', 'Europe/Zurich') }}</small>{% else %}<span class="badge text-bg-warning">Kein Preis</span>{% endif %}</td><td><form class="d-flex flex-column gap-2" method="post" action="{{ path('platform_billing_price', {publicId: product.public_id, mit_deaktivierten: include_inactive ? 1 : null}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_price_' ~ product.public_id) }}"><input class="form-control form-control-sm" name="amount" inputmode="decimal" placeholder="CHF, z.B. 149.00" required><input class="form-control form-control-sm" type="datetime-local" name="valid_from"><button class="btn btn-sm btn-outline-primary" type="submit">Preis speichern</button></form></td><td><div class="d-flex flex-column gap-2"><form method="post" action="{{ path('platform_billing_product_action', {publicId: product.public_id, action: product.active ? 'deaktivieren' : 'aktivieren', mit_deaktivierten: include_inactive ? 1 : null}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_product_' ~ product.public_id) }}"><button class="btn btn-sm btn-outline-secondary w-100" type="submit">{{ product.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form><form method="post" action="{{ path('platform_billing_product_delete', {publicId: product.public_id, mit_deaktivierten: include_inactive ? 1 : null}) }}" data-confirm="Produkt wirklich löschen? Bereits verwendete Produkte bleiben aus rechtlichen Gründen erhalten."><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_product_delete_' ~ product.public_id) }}"><button class="btn btn-sm btn-outline-danger w-100" type="submit">Löschen</button></form></div></td></tr>{% else %}<tr><td colspan="5" class="text-body-secondary">{{ include_inactive ? 'Noch keine Produkte vorhanden.' : 'Keine aktiven Produkte. Mit „Mit deaktivierten“ können archivierte Produkte eingeblendet werden.' }}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
<div class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5">Sportmodule plattformweit</h2><p class="text-body-secondary">Die Preisabdeckung zeigt, ob ein Modul im Grundabo oder als Zusatzmodul gebucht werden kann. Eine Aktivierung ist nur mit einem aktiven Produkt und aktuell gültigem Preis möglich.</p></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Modul</th><th>Komplexität</th><th>Technischer Status</th><th>Preisabdeckung</th><th></th></tr></thead><tbody>{% for module in modules %}<tr class="{{ module.active and module.priced_product_count == 0 ? 'table-warning' : '' }}"><td>{{ module.name }}<small class="d-block text-body-secondary"><code>{{ module.code }}</code></small></td><td>{{ module.complexity }}</td><td><span class="badge text-bg-{{ module.active ? 'success' : 'secondary' }}">{{ module.active ? 'aktiv' : 'deaktiviert' }}</span></td><td>{% if module.product_count == 0 %}<span class="badge text-bg-danger">Produkt fehlt</span><small class="d-block text-body-secondary">Modulprodukt anlegen</small>{% elseif module.active_product_count == 0 %}<span class="badge text-bg-warning">Produkt deaktiviert</span><small class="d-block text-body-secondary">Produkt zuerst aktivieren</small>{% elseif module.priced_product_count > 0 %}<span class="badge text-bg-success">Buchbar</span><small class="d-block text-body-secondary">{{ module.priced_product_count }} aktive{{ module.priced_product_count == 1 ? 's' : '' }} Preisangebot{{ module.priced_product_count == 1 ? '' : 'e' }}</small>{% elseif module.future_price_count > 0 %}<span class="badge text-bg-info">Preis erst zukünftig gültig</span><small class="d-block text-body-secondary">Bis dahin nicht buchbar</small>{% else %}<span class="badge text-bg-danger">Preis fehlt</span><small class="d-block text-body-secondary">Aktuelle Preisversion erfassen</small>{% endif %}</td><td><form method="post" action="{{ path('platform_billing_module_action', {code: module.code, action: module.active ? 'deaktivieren' : 'aktivieren'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_module_' ~ module.code) }}"><button class="btn btn-sm btn-outline-secondary"{% if not module.active and module.priced_product_count == 0 %} disabled title="Zuerst ein aktives Produkt mit gültigem Preis erfassen"{% endif %}>{{ module.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form></td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}

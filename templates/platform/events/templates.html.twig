{% extends 'platform/base.html.twig' %}{% block title %}Veranstaltungsvorlagen{% endblock %}{% block platform_body %}<h1 class="h2 mb-4">Globale Veranstaltungsvorlagen</h1>{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Vorlagenversion speichern</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('platform_event_templates') }}"><input type="hidden" name="action" value="template"><label class="form-label">Vorlagen-ID bei neuer Version (optional)</label><input class="form-control mb-2" name="template_id"><label class="form-label">Name</label><input class="form-control mb-2" name="name" required><label class="form-label">Modul</label><select class="form-select mb-2" name="module">{% for module in modules %}<option value="{{ module.code }}">{{ module.name }}</option>{% endfor %}</select><label class="form-label">Konfiguration (JSON)</label><textarea class="form-control font-monospace mb-3" name="configuration" required>{}</textarea><button class="btn btn-primary">Version speichern</button></form></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Modulstandard versionieren</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('platform_event_templates') }}"><input type="hidden" name="action" value="defaults"><select class="form-select mb-2" name="module">{% for module in modules %}<option value="{{ module.code }}">{{ module.name }}</option>{% endfor %}</select><textarea class="form-control font-monospace mb-2" name="configuration" required>{}</textarea><button class="btn btn-outline-primary">Standard speichern</button></form></div></div>{% for template in templates %}<div class="card border-0 shadow-sm mb-2"><div class="card-body d-flex justify-content-between"><div><strong>{{ template.name }}</strong><br><small>{{ template.module_name }} · Version {{ template.version_number }}</small></div><form method="post" action="{{ path('platform_event_template_toggle',{id:template.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('template_toggle_'~template.public_id) }}"><button class="btn btn-sm btn-outline-secondary">{{ template.active ? 'Deaktivieren':'Aktivieren' }}</button></form></div></div>{% endfor %}</div></div>{% endblock %}

{% extends 'base.html.twig' %}{% block title %}Bestätigung erneut senden{% endblock %}{% block shell %}<main id="main-content" class="container py-5 auth-shell"><div class="card border-0 shadow-sm"><div class="card-body p-4 p-md-5"><h1 class="h3">Bestätigung erneut senden</h1>{% if sent %}<div class="alert alert-success">Falls die offene Registrierung existiert, wurde ein neuer Link versendet. Die ursprüngliche 7-Tage-Frist bleibt bestehen.</div>{% else %}<form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('registration_resend') }}"><div class="mb-3"><label class="form-label" for="slug">Vereins-Slug</label><input class="form-control" id="slug" name="slug" required></div><div class="mb-3"><label class="form-label" for="email">Owner-E-Mail</label><input class="form-control" id="email" name="email" type="email" required></div><button class="btn btn-primary" type="submit">Bestätigung senden</button></form>{% endif %}</div></div></main>{% endblock %}

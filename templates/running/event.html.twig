{% extends 'base.html.twig' %}
{% block title %}Laufmodul · {{ run.event.name }}{% endblock %}
{% block javascripts %}<script src="/assets/js/running.js" defer></script>{% endblock %}
{% block body %}
<div data-running-revision="{{ run.revision }}" data-running-revision-url="{{ path('running_revision',{slug:tenant.slug,id:run.event.public_id}) }}"><div class="d-flex justify-content-between mb-4"><div><p class="eyebrow">Laufanlass</p><h1 class="h2">{{ run.event.name }}</h1></div><a href="{{ path('tenant_event',{slug:tenant.slug,id:run.event.public_id}) }}">Veranstaltung</a></div>
<div class="alert alert-warning d-none" data-running-stale>Ein anderer Arbeitsplatz hat Laufdaten geändert. Bitte neu laden, bevor du speicherst.</div>
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Konfiguration</h2><form method="post" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="configure"><input type="hidden" name="lock_version" value="{{ run.settings.lock_version }}"><div class="col"><input class="form-control" type="number" min="1" max="20" name="qualification_runs" value="{{ run.settings.qualification_runs }}"></div><div class="col"><input class="form-control" type="number" min="1" max="50" name="finalists" value="{{ run.settings.finalists_per_category }}"></div><div class="col"><select class="form-select" name="precision"><option value="tenths" {{ run.settings.time_precision=='tenths'?'selected' }}>Zehntel</option><option value="hundredths" {{ run.settings.time_precision=='hundredths'?'selected' }}>Hundertstel</option></select></div><div class="col"><label><input type="checkbox" name="final_enabled" value="1" {{ run.settings.final_enabled?'checked' }}> Finale</label></div><div class="col"><button class="btn btn-primary">Speichern</button></div></form></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Kategorie anlegen</h2><form method="post" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="category"><div class="col"><input class="form-control" name="name" placeholder="Name" required></div><div class="col"><input class="form-control" type="number" name="year_from" placeholder="Jahr von" required></div><div class="col"><input class="form-control" type="number" name="year_to" placeholder="Jahr bis" required></div><div class="col"><select class="form-select" name="gender"><option value="female">Weiblich</option><option value="male">Männlich</option><option value="other">Divers</option></select></div><div class="col"><button class="btn btn-primary">Anlegen</button></div></form><div class="mt-2">{% for c in categories %}<span class="badge text-bg-secondary">{{ c.name }} {{ c.birth_year_from }}–{{ c.birth_year_to }} / {{ c.gender }}</span> {% endfor %}</div></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Schnellzeiterfassung Qualifikation</h2><p class="small">Zeit oder DNS, DNF, DSQ eingeben.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="qualification"><div class="table-responsive"><table class="table"><thead><tr><th>Nr.</th><th>Teilnehmer</th><th>Kategorie</th>{% for n in 1..run.settings.qualification_runs %}<th>Lauf {{ n }}</th>{% endfor %}</tr></thead><tbody>{% for p in run.participants %}<tr class="{{ p.category_id ? '' : 'table-warning' }}"><td>{{ p.start_number }}</td><td>{{ p.first_name }} {{ p.last_name }}</td><td>{{ p.category_name ?: 'keiner Kategorie zugeordnet' }}</td>{% for n in 1..run.settings.qualification_runs %}<td><input type="hidden" name="qualification_versions[{{ p.public_id }}][{{ n }}]" value="{{ run.qualification_versions[p.public_id][n]|default(0) }}"><input class="form-control form-control-sm" name="times[{{ p.public_id }}][{{ n }}]" value="{{ run.inputs[p.id][n]|default('') }}"></td>{% endfor %}</tr>{% endfor %}</tbody></table></div><button class="btn btn-primary">Qualifikationszeiten speichern</button></form></div></div>
<div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Qualifikation &amp; Finalisten</h2>{% if run.settings.finalists_confirmed_at %}<div class="alert alert-info py-2">Die Finalistenauswahl ist bestätigt und gesperrt.</div>{% endif %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="finalists">{% for group,rows in run.qualification %}<h3 class="h6 mt-3">{{ group }}</h3><ol>{% for row in rows %}{% set p=run.participants_by_id[row.id] %}<li><label>{% if run.settings.final_enabled %}<input type="checkbox" name="finalists[]" value="{{ row.id }}" {{ (p.finalist_confirmed or run.proposed_finalists[row.id]|default(false))?'checked' }} {{ run.settings.finalists_confirmed_at?'disabled' }}>{% endif %} Rang {{ row.rank }} · {{ p.first_name }} {{ p.last_name }} · {{ row.times[0]|default(null)|running_time(run.settings.time_precision) }}</label></li>{% endfor %}</ol>{% endfor %}{% if run.settings.final_enabled %}<button class="btn btn-primary" {{ run.settings.finalists_confirmed_at?'disabled' }}>Finalisten bestätigen</button>{% else %}<p class="text-muted">Das Finale ist deaktiviert; die Qualifikation ist zugleich die Schlussrangliste.</p>{% endif %}</form>{% if run.settings.final_enabled %}<form method="post" class="mt-3"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="reset_finalists"><input class="form-control mb-2" name="reason" placeholder="Begründung"><button class="btn btn-outline-danger">Bestätigung zurücksetzen</button></form>{% endif %}</div></div></div>
<div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Finale</h2>{% if run.settings.final_enabled %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="finals">{% for group,participants in run.finalists %}<h3 class="h6 mt-3">{{ group }}</h3>{% for p in participants %}<label class="form-label d-block">{{ p.final_start_order }}. {{ p.first_name }} {{ p.last_name }}<input type="hidden" name="final_versions[{{ p.public_id }}]" value="{{ run.final_versions[p.public_id]|default(0) }}"><input class="form-control" name="final_times[{{ p.public_id }}]" value="{{ run.final_inputs[p.public_id]|default('') }}" placeholder="Zeit / DNS / DNF / DSQ"></label>{% endfor %}{% endfor %}<button class="btn btn-primary">Finalzeiten speichern</button></form>{% else %}<p class="text-muted mb-0">Kein separater Finallauf konfiguriert.</p>{% endif %}</div></div></div></div>
<div class="card border-0 shadow-sm mt-4"><div class="card-body"><h2 class="h5">Schlussrangliste</h2>{% for group,rows in run.finals %}<h3 class="h6 mt-3">{{ group }}</h3><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Rang</th><th>Teilnehmer</th><th>Zeit / Status</th></tr></thead><tbody>{% for row in rows %}{% set p=run.participants_by_id[row.id] %}<tr><td>{{ row.rank|default('–') }}</td><td>{{ p.first_name }} {{ p.last_name }}</td><td>{% if row.status.value == 'valid' %}{{ row.time|running_time(run.settings.time_precision) }}{% else %}{{ row.status.value|upper }}{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p class="text-muted mb-0">Noch keine Schlussrangliste verfügbar.</p>{% endfor %}</div></div>
<div class="mt-4">{% for document,label in {'sheets':'Laufzettel','qualification':'Qualifikationsranglisten','finalists':'Finalistenlisten','final':'Schlussranglisten'} %}<a class="btn btn-outline-secondary" href="{{ path('running_pdf',{slug:tenant.slug,id:run.event.public_id,document:document}) }}">{{ label }} PDF</a> <a class="btn btn-link" href="{{ path('running_print',{slug:tenant.slug,id:run.event.public_id,document:document}) }}">Druckansicht</a> {% endfor %}</div>
<div class="row g-4 mt-1"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Kategorien bearbeiten</h2>{% for c in categories %}<form method="post" class="row g-1 mb-2"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="category_update"><input type="hidden" name="category_id" value="{{ c.public_id }}"><input type="hidden" name="lock_version" value="{{ c.lock_version }}"><div class="col"><input class="form-control form-control-sm" name="name" value="{{ c.name }}"></div><div class="col"><input class="form-control form-control-sm" type="number" name="year_from" value="{{ c.birth_year_from }}"></div><div class="col"><input class="form-control form-control-sm" type="number" name="year_to" value="{{ c.birth_year_to }}"></div><div class="col"><select class="form-select form-select-sm" name="gender"><option value="female" {{ c.gender=='female'?'selected' }}>W</option><option value="male" {{ c.gender=='male'?'selected' }}>M</option><option value="other" {{ c.gender=='other'?'selected' }}>D</option></select></div><div class="col-auto"><button class="btn btn-sm btn-outline-primary">Ändern</button></div></form>{% endfor %}</div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Startnummern</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('running_'~run.event.public_id) }}"><input type="hidden" name="action" value="start_numbers">{% for p in run.participants %}<label class="d-flex gap-2 mb-1"><input type="hidden" name="number_versions[{{ p.public_id }}]" value="{{ p.lock_version }}"><input class="form-control form-control-sm w-auto" type="number" min="1" max="1000000000" name="numbers[{{ p.public_id }}]" value="{{ p.start_number }}"><span>{{ p.first_name }} {{ p.last_name }}</span></label>{% endfor %}<button class="btn btn-outline-primary mt-2">Startnummern speichern</button></form></div></div></div></div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Audit · {{ tenant.name }}{% endblock %}
{% block body %}
<div class="mb-4"><p class="eyebrow">Einstellungen</p><h1 class="h2">Vereins-Audit</h1><p class="text-body-secondary">Sicherheitsrelevante Änderungen und transparente Supportzugriffe.</p></div>
<form class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="row g-3"><div class="col-md-3"><label class="form-label" for="action">Aktion</label><input class="form-control" id="action" name="action" value="{{ filters.action }}"></div><div class="col-md-3"><label class="form-label" for="user">Benutzer</label><select class="form-select" id="user" name="user"><option value="">Alle</option>{% for user in users %}<option value="{{ user.public_id }}" {% if filters.user == user.public_id %}selected{% endif %}>{{ user.display_name ?: user.email }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label" for="from">Von</label><input class="form-control" type="date" id="from" name="from" value="{{ filters.from }}"></div><div class="col-md-2"><label class="form-label" for="to">Bis</label><input class="form-control" type="date" id="to" name="to" value="{{ filters.to }}"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Filtern</button></div></div></div></form>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Zeit</th><th>Aktion</th><th>Objekt</th><th>Akteur</th><th>Kontext</th></tr></thead><tbody>{% for entry in entries %}<tr><td class="text-nowrap">{{ entry.occurred_at|date('d.m.Y H:i:s', 'Europe/Zurich') }}</td><td><code>{{ entry.action }}</code></td><td>{{ entry.subject_type }}<small class="d-block text-body-secondary">{{ entry.subject_public_id }}</small></td><td>{{ entry.platform_admin ? entry.platform_admin ~ ' (Plattformsupport)' : (entry.tenant_user ?: 'System') }}</td><td><small class="text-break">{{ entry.context }}</small></td></tr>{% else %}<tr><td colspan="5" class="text-body-secondary">Keine Einträge gefunden.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}

{% extends 'base.html.twig' %}{% block title %}Abrechnung · {{ tenant.name }}{% endblock %}{% block body %}
<div class="d-flex justify-content-between mb-4"><div><p class="eyebrow">Verein</p><h1 class="h2">Abo und Abrechnung</h1></div><a class="btn btn-outline-secondary" href="{{ path('tenant_dashboard', {slug: tenant.slug}) }}">Zurück</a></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="row g-4"><div class="col-xl-7"><div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><h2 class="h5">Hauptabo</h2>
{% if billing.subscription %}<dl class="row"><dt class="col-sm-4">Status</dt><dd class="col-sm-8">{{ billing.subscription.status }}</dd><dt class="col-sm-4">Hauptmodul</dt><dd class="col-sm-8">{{ billing.subscription.main_module_name }}</dd><dt class="col-sm-4">Laufzeit</dt><dd class="col-sm-8">{{ billing.subscription.starts_at|date('d.m.Y') }}–{{ billing.subscription.ends_at|date('d.m.Y') }}</dd></dl><ul>{% for module in billing.modules %}<li>{{ module.name }} · {{ module.module_role == 'main' ? 'Hauptmodul' : 'Zusatzmodul' }} · bis {{ module.ends_at|date('d.m.Y') }}</li>{% endfor %}</ul>{% if is_granted('ROLE_TENANT_OWNER') and billing.subscription.status == 'active' %}<div class="d-flex gap-2"><form method="post" action="{{ path('tenant_billing_renewal', {slug: tenant.slug}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_renewal') }}"><input type="hidden" name="enabled" value="{{ billing.subscription.auto_renew ? '0' : '1' }}"><button class="btn btn-outline-primary" type="submit">Verlängerung {{ billing.subscription.auto_renew ? 'deaktivieren' : 'aktivieren' }}</button></form><form method="post" action="{{ path('tenant_billing_cancel', {slug: tenant.slug}) }}" onsubmit="return confirm('Abo wirklich kündigen?')"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_cancel') }}"><button class="btn btn-outline-danger">Kündigen</button></form></div>{% endif %}
{% else %}<p>Noch kein kostenpflichtiges Abo.</p>{% if catalogue.main_products and catalogue.modules %}<form method="post" action="{{ path('tenant_billing_book', {slug: tenant.slug}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_book') }}"><div class="mb-3"><label class="form-label">Jahresabo</label><select class="form-select" name="main_product">{% for p in catalogue.main_products %}<option value="{{ p.public_id }}">{{ p.name }} · {{ p.currency }} {{ (p.amount_minor / 100)|number_format(2, '.', "'") }}</option>{% endfor %}</select></div><fieldset class="mb-3"><legend class="form-label">Module (erste Auswahl ist Hauptmodul)</legend>{% for m in catalogue.modules %}<div class="form-check"><input class="form-check-input" type="checkbox" name="modules[]" value="{{ m.public_id }}" id="m{{ loop.index }}"><label class="form-check-label" for="m{{ loop.index }}">{{ m.module_name ?: m.name }} · {{ m.currency }} {{ (m.amount_minor / 100)|number_format(2, '.', "'") }}</label></div>{% endfor %}</fieldset><div class="mb-3"><label class="form-label">Gutschein</label><input class="form-control" name="coupon"></div><button class="btn btn-primary">Kostenpflichtig per Rechnung buchen</button></form>{% else %}<div class="alert alert-warning">Noch keine bepreisten Produkte verfügbar.</div>{% endif %}{% endif %}</div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Rechnungsarchiv</h2></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Nummer</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>{% for i in billing.invoices %}<tr><td>{{ i.invoice_number }}</td><td>{{ i.status }}</td><td>{{ i.currency }} {{ (i.total_minor / 100)|number_format(2, '.', "'") }}</td><td><a class="btn btn-sm btn-outline-secondary" href="{{ path('tenant_invoice_pdf', {slug: tenant.slug, publicId: i.public_id}) }}">PDF</a></td></tr>{% else %}<tr><td colspan="4">Noch keine Rechnungen.</td></tr>{% endfor %}</tbody></table></div></div></div>
<div class="col-xl-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Rechnungsdaten</h2>{% set p = billing.profile|default({}) %}<form method="post" action="{{ path('tenant_billing_profile', {slug: tenant.slug}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('billing_profile') }}"><div class="mb-3"><label class="form-label">Vereinsname</label><input class="form-control" name="club_name" value="{{ p.club_name|default(tenant.name) }}" required></div><div class="mb-3"><label class="form-label">Strasse / Hausnummer</label><input class="form-control" name="address_line" value="{{ p.address_line|default('') }}" required></div><div class="row"><div class="col-4 mb-3"><label class="form-label">PLZ</label><input class="form-control" name="postal_code" value="{{ p.postal_code|default('') }}" required></div><div class="col-8 mb-3"><label class="form-label">Ort</label><input class="form-control" name="city" value="{{ p.city|default('') }}" required></div></div><input type="hidden" name="country_code" value="{{ p.country_code|default('CH') }}"><div class="mb-3"><label class="form-label">Rechnungs-E-Mail</label><input class="form-control" type="email" name="invoice_email" value="{{ p.invoice_email|default(app.user.email) }}" required>{% if p.pending_invoice_email|default(false) %}<div class="form-text">Ausstehend: {{ p.pending_invoice_email }}</div>{% endif %}</div><div class="mb-3"><label class="form-label">Kontaktperson</label><input class="form-control" name="contact_name" value="{{ p.contact_name|default(app.user.displayName) }}" required></div><div class="mb-3"><label class="form-label">Empfänger (optional)</label><input class="form-control" name="recipient" value="{{ p.recipient|default('') }}"></div><div class="row"><div class="col-6 mb-3"><label class="form-label">Bestellnummer</label><input class="form-control" name="order_number" value="{{ p.order_number|default('') }}"></div><div class="col-6 mb-3"><label class="form-label">Kostenstelle</label><input class="form-control" name="cost_center" value="{{ p.cost_center|default('') }}"></div></div><div class="mb-3"><label class="form-label">Rechnungsreferenz</label><input class="form-control" name="invoice_reference" value="{{ p.invoice_reference|default('') }}"></div><button class="btn btn-dark">Speichern</button></form></div></div></div></div>{% endblock %}

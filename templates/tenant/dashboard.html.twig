{% extends 'base.html.twig' %}
{% block title %}{{ tenant.name }}{% endblock %}
{% block body %}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4"><div><p class="eyebrow mb-2">{{ tenant.status.value == 'trial' ? 'Testphase' : 'Verein' }}</p><h1 class="display-6 mb-1">{{ tenant.name }}</h1><p class="text-body-secondary">Angemeldet als {{ app.user.displayName }} · {{ app.user.tenantRole.value }}</p><a class="btn btn-sm btn-primary mt-2" href="{{ path('tenant_events', {slug: tenant.slug}) }}">Veranstaltungen</a> <a class="btn btn-sm btn-outline-primary mt-2" href="{{ path('tenant_event_templates', {slug: tenant.slug}) }}">Vorlagen</a> <a class="btn btn-sm btn-outline-primary mt-2" href="{{ path('tenant_notifications', {slug: tenant.slug}) }}">Benachrichtigungen</a></div><form method="post" action="{{ path('tenant_logout', {slug: tenant.slug}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('tenant_logout') }}"><button class="btn btn-outline-secondary" type="submit">Abmelden</button></form></div>
<div class="row g-4"><div class="col-md-7"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h2 class="h4">Vereinsplattform</h2><p>Mandant, Anmeldung, Rollen und Sitzungsabsicherung sind eingerichtet.</p>{% if is_granted('ROLE_TENANT_OWNER') or is_granted('ROLE_TENANT_ADMINISTRATOR') %}<a class="btn btn-outline-primary" href="{{ path('tenant_users', {slug: tenant.slug}) }}">Benutzer verwalten</a> <a class="btn btn-outline-primary" href="{{ path('tenant_billing', {slug: tenant.slug}) }}">Abo &amp; Rechnungen</a> <a class="btn btn-outline-secondary" href="{{ path('tenant_audit', {slug: tenant.slug}) }}">Audit</a> <a class="btn btn-outline-secondary" href="{{ path('tenant_system_status', {slug: tenant.slug}) }}">Systemstatus</a>{% endif %} {% if is_granted('ROLE_TENANT_OWNER') %}<a class="btn btn-outline-secondary" href="{{ path('tenant_support_settings', {slug: tenant.slug}) }}">Supportzugriff</a>{% endif %}</div></div></div><div class="col-md-5"><div class="card border-0 shadow-sm h-100"><div class="card-body p-4"><h2 class="h5">Testmodul</h2><p class="mb-0">{{ tenant.trialModule.label }}</p></div></div></div></div>
<div class="mt-4">{% if app.user.twoFactor %}<span class="badge text-bg-success">2FA aktiv</span>{% if not app.user.requiresTwoFactor %} <a href="{{ path('tenant_2fa_disable', {slug: tenant.slug}) }}">deaktivieren</a>{% endif %}{% else %}<a href="{{ path('tenant_2fa_setup', {slug: tenant.slug}) }}">Zwei-Faktor-Authentisierung aktivieren</a>{% endif %}</div>
{% endblock %}

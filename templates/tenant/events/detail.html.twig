{% extends 'base.html.twig' %}{% block title %}{{ event.name }} · {{ tenant.name }}{% endblock %}{% block body %}
{% if event.module_code == 'running_event' %}<a class="btn btn-primary mb-3" href="{{ path('running_event',{slug:tenant.slug,id:event.public_id}) }}">Laufmodul öffnen</a>{% endif %}
{% if event.module_code == 'football_tournament' %}<a class="btn btn-primary mb-3" href="{{ path('football_event',{slug:tenant.slug,id:event.public_id}) }}">Fussballmodul öffnen</a>{% endif %}
<nav aria-label="Veranstaltungskontext" class="mb-3"><a href="{{ path('tenant_events', {slug: tenant.slug}) }}">Veranstaltungen</a> / <strong>{{ event.name }}</strong></nav><a class="btn btn-primary mb-3" href="{{ path('tenant_event_roster',{slug:tenant.slug,id:event.public_id}) }}">Teilnehmer &amp; Teams</a>{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><div class="d-flex justify-content-between"><div><p class="eyebrow">{{ event.module_name }}</p><h1 class="h2">{{ event.name }}</h1></div><span class="badge text-bg-primary align-self-start">{{ event.status }}</span></div><dl class="row mb-0"><dt class="col-sm-3">Zeitraum</dt><dd class="col-sm-9">{{ event.starts_on|date('d.m.Y') }}–{{ event.ends_on|date('d.m.Y') }}</dd><dt class="col-sm-3">Ort</dt><dd class="col-sm-9">{{ event.location ?: '–' }}</dd><dt class="col-sm-3">Primäre Leitung</dt><dd class="col-sm-9">{{ event.manager_name }}</dd>{% if event.cancellation_reason %}<dt class="col-sm-3">Abbruchgrund</dt><dd class="col-sm-9">{{ event.cancellation_reason }}</dd>{% endif %}</dl></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Status ändern</h2><form method="post" action="{{ path('tenant_event_status', {slug: tenant.slug, id: event.public_id}) }}" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('event_status_' ~ event.public_id) }}"><div class="col-md-5"><select class="form-select" name="status"><option value="preparation">Vorbereitung</option><option value="running">Laufend</option><option value="completed">Abgeschlossen</option><option value="cancelled">Abgebrochen</option><option value="archived">Archiviert</option></select></div><div class="col-md-7"><input class="form-control" name="reason" placeholder="Pflichtbegründung bei Abbruch"></div><div class="col-12"><label><input type="checkbox" name="confirmed" value="1"> Endgültigen Wechsel ausdrücklich bestätigen</label></div><div><button class="btn btn-primary">Status anwenden</button></div></form></div></div></div><div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Struktur duplizieren</h2><form method="post" action="{{ path('tenant_event_duplicate', {slug: tenant.slug, id: event.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_duplicate_' ~ event.public_id) }}"><input class="form-control mb-2" name="name" value="Kopie von {{ event.name }}" required><button class="btn btn-outline-primary">Duplizieren</button></form>{% if event.status == 'archived' and (is_granted('ROLE_TENANT_OWNER') or is_granted('ROLE_TENANT_ADMINISTRATOR')) %}<hr><form method="post" action="{{ path('tenant_event_delete', {slug: tenant.slug, id: event.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_delete_' ~ event.public_id) }}"><label class="d-block mb-2"><input type="checkbox" name="confirmed" value="1" required> Endgültige Löschung bestätigen</label><button class="btn btn-danger">Endgültig löschen</button></form>{% endif %}</div></div></div></div>{% endblock %}

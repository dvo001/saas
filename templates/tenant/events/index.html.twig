{% extends 'base.html.twig' %}{% block title %}Veranstaltungen · {{ tenant.name }}{% endblock %}{% block body %}
<div class="d-flex justify-content-between mb-4"><div><p class="eyebrow">Verein</p><h1 class="h2">Veranstaltungen</h1></div><a class="btn btn-outline-secondary" href="{{ path('tenant_dashboard', {slug: tenant.slug}) }}">Dashboard</a></div>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
{% if is_granted('ROLE_TENANT_OWNER') or is_granted('ROLE_TENANT_ADMINISTRATOR') %}<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">Neue Veranstaltung</h2><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('event_create') }}"><div class="col-md-6"><label class="form-label">Name</label><input class="form-control" name="name" required></div><div class="col-md-3"><label class="form-label">Modul</label><select class="form-select" name="module" required>{% for module in modules %}<option value="{{ module.code }}">{{ module.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Vorlage</label><select class="form-select" name="template"><option value="">Modulstandard</option>{% for template in templates %}<option value="{{ template.public_id }}">{{ template.name }}</option>{% endfor %}</select></div><div class="col-md-3"><label class="form-label">Start</label><input class="form-control" type="date" name="starts_on" required></div><div class="col-md-3"><label class="form-label">Ende</label><input class="form-control" type="date" name="ends_on" required></div><div class="col-md-6"><label class="form-label">Ort</label><input class="form-control" name="location"></div><div class="col-12"><label class="form-label">Interne Notizen</label><textarea class="form-control" name="notes"></textarea></div><div><button class="btn btn-primary">Erstellen</button></div></form></div></div>{% endif %}
<div class="row g-3">{% for event in events %}<div class="col-md-6 col-xl-4"><a class="card border-0 shadow-sm text-decoration-none h-100" href="{{ path('tenant_event', {slug: tenant.slug, id: event.public_id}) }}"><div class="card-body"><span class="badge text-bg-secondary">{{ event.status }}</span><h2 class="h5 mt-2">{{ event.name }}</h2><p class="mb-1">{{ event.module_name }}</p><small class="text-body-secondary">{{ event.starts_on|date('d.m.Y') }}–{{ event.ends_on|date('d.m.Y') }} · {{ event.location ?: 'Ort offen' }}</small></div></a></div>{% else %}<p class="text-body-secondary">Noch keine sichtbaren Veranstaltungen.</p>{% endfor %}</div>{% endblock %}

{% extends 'base.html.twig' %}{% block title %}Meldungen · {{ roster.event.name }}{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><div><p class="eyebrow">{{ roster.event.name }}</p><h1 class="h2">Teilnehmer und Teams</h1></div><a href="{{ path('tenant_event',{slug:tenant.slug,id:roster.event.public_id}) }}">Veranstaltung</a></div>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<div class="row g-4 mb-4"><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Teilnehmer erfassen</h2><form method="post" class="row g-2"><input type="hidden" name="_token" value="{{ csrf_token('event_roster_'~roster.event.public_id) }}"><input type="hidden" name="action" value="participant"><div class="col-12"><select class="form-select" name="registry"><option value="">Direkte Erfassung</option>{% for p in roster.registry %}<option value="{{ p.public_id }}">{{ p.last_name }} {{ p.first_name }} ({{ p.birth_year }})</option>{% endfor %}</select></div><div class="col"><input class="form-control" name="first_name" placeholder="Vorname"></div><div class="col"><input class="form-control" name="last_name" placeholder="Nachname"></div><div class="col-4"><input class="form-control" type="number" name="birth_year" placeholder="Jahr"></div><div><button class="btn btn-primary">Hinzufügen</button></div></form></div></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Team erfassen</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('event_roster_'~roster.event.public_id) }}"><input type="hidden" name="action" value="team"><input class="form-control mb-2" type="number" min="1" name="team_number" placeholder="Teamnummer (leer = automatisch)"><input class="form-control mb-2" name="name" placeholder="Teamname" required><input class="form-control mb-2" name="category" placeholder="Kategorie"><button class="btn btn-primary">Hinzufügen</button></form></div></div></div></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5">CSV-Import</h2><a href="{{ path('tenant_event_csv_template',{slug:tenant.slug,id:roster.event.public_id}) }}">Feste Vorlage herunterladen</a><form class="mt-2" method="post" enctype="multipart/form-data" action="{{ path('tenant_event_csv_preview',{slug:tenant.slug,id:roster.event.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event_csv_'~roster.event.public_id) }}"><input type="file" name="csv" accept=".csv,text/csv" required> <button class="btn btn-outline-primary">Validieren und Vorschau</button></form></div></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Jahr</th><th>Team</th><th>Zuweisen</th></tr></thead><tbody>{% for p in roster.participants %}<tr><td>{{ p.first_name }} {{ p.last_name }}</td><td>{{ p.birth_year }}</td><td>{{ p.team_name ?: '–' }}</td><td>{% if roster.teams %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('event_roster_'~roster.event.public_id) }}"><input type="hidden" name="action" value="assign"><input type="hidden" name="participant" value="{{ p.public_id }}"><select name="team">{% for t in roster.teams %}<option value="{{ t.public_id }}">{{ t.name }}</option>{% endfor %}</select> <button class="btn btn-sm btn-outline-secondary">Zuweisen</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4">Keine Teilnehmer.</td></tr>{% endfor %}</tbody></table></div></div>{% endblock %}

{% extends 'base.html.twig' %}{% block title %}Vereinsvorlagen · {{ tenant.name }}{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2">Vereinseigene Vorlagen</h1><a href="{{ path('tenant_events',{slug:tenant.slug}) }}">Veranstaltungen</a></div>{% for messages in app.flashes %}{% for message in messages %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}{% endfor %}{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('tenant_event_template') }}"><div class="col-md-5"><input class="form-control" name="name" placeholder="Name" required></div><div class="col-md-3"><select class="form-select" name="module">{% for module in modules %}<option value="{{ module.code }}">{{ module.name }}</option>{% endfor %}</select></div><div class="col-md-4"><textarea class="form-control font-monospace" name="configuration" required>{}</textarea></div><div><button class="btn btn-primary">Vorlage erstellen</button></div></form></div></div>{% for template in templates %}<div class="card border-0 shadow-sm mb-2"><div class="card-body d-flex justify-content-between"><span><strong>{{ template.name }}</strong> · {{ template.module_name }}</span><form method="post" action="{{ path('tenant_event_template_delete',{slug:tenant.slug,id:template.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('tenant_template_delete_'~template.public_id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></div></div>{% else %}<p>Keine Vereinsvorlagen.</p>{% endfor %}{% endblock %}

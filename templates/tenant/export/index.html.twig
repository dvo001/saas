{% extends 'base.html.twig' %}
{% block title %}Datenexport · {{ tenant.name }}{% endblock %}
{% block body %}
<nav class="mb-3"><a href="{{ path('tenant_dashboard',{slug:tenant.slug}) }}">Dashboard</a> / <strong>Datenexport</strong></nav>
{% for type,messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><h1 class="h3">Vollständiger Datenexport</h1><p>Der Export enthält Vereins- und Veranstaltungsdaten als CSV sowie vorhandene Abschluss- und Rechnungs-PDFs. Das Audit-Protokoll ist ausdrücklich ausgeschlossen. Fertige Exporte werden nach sieben Tagen gelöscht.</p><form method="post" action="{{ path('tenant_export_request',{slug:tenant.slug}) }}"><input type="hidden" name="_token" value="{{ csrf_token('tenant_export_request') }}"><button class="btn btn-primary">ZIP-Export anfordern</button></form></div></div>
{% if download_job %}<div class="card border-primary shadow-sm mb-4"><div class="card-body"><h2 class="h5">Download erneut bestätigen</h2><p>Gib aus Sicherheitsgründen dein Passwort und einen aktuellen Zwei-Faktor-Code ein.</p>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}<form method="post" class="row g-3"><input type="hidden" name="_token" value="{{ csrf_token('tenant_export_download_' ~ download_job.public_id) }}"><div class="col-md-6"><label class="form-label">Passwort</label><input class="form-control" type="password" name="password" autocomplete="current-password" required></div><div class="col-md-3"><label class="form-label">2FA-Code</label><input class="form-control" name="code" inputmode="numeric" pattern="[0-9]{6}" required></div><div class="col-12"><button class="btn btn-primary">ZIP herunterladen</button></div></form></div></div>{% endif %}
<div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Bisherige Exporte</h2><div class="table-responsive"><table class="table"><thead><tr><th>Angefordert</th><th>Status</th><th>Verfügbar bis</th><th></th></tr></thead><tbody>{% for job in jobs %}<tr><td>{{ job.created_at|date('d.m.Y H:i') }}</td><td>{{ job.status }}</td><td>{{ job.expires_at ? job.expires_at|date('d.m.Y H:i') : '–' }}</td><td>{% if job.status == 'ready' %}<a class="btn btn-sm btn-outline-primary" href="{{ path('tenant_export_download',{slug:tenant.slug,id:job.public_id}) }}">Herunterladen</a>{% elseif job.status == 'failed' %}<small>Referenz: {{ job.error_reference }}</small>{% endif %}</td></tr>{% else %}<tr><td colspan="4">Noch keine Exporte angefordert.</td></tr>{% endfor %}</tbody></table></div></div></div>
{% endblock %}

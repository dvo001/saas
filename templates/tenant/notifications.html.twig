{% extends 'base.html.twig' %}
{% block title %}Benachrichtigungen · {{ tenant.name }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="eyebrow">Verein</p><h1 class="h2">Benachrichtigungen</h1></div><a class="btn btn-outline-secondary" href="{{ path('tenant_dashboard', {slug: tenant.slug}) }}">Zurück</a></div>
<div class="vstack gap-3">{% for notification in notifications %}<article class="card border-{{ notification.read_at ? 'light' : (notification.severity == 'danger' ? 'danger' : (notification.severity == 'warning' ? 'warning' : 'primary')) }} shadow-sm"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><h2 class="h5">{{ notification.title }}</h2><p class="mb-2">{{ notification.message }}</p><small class="text-body-secondary">{{ notification.created_at|date('d.m.Y H:i', 'Europe/Zurich') }}</small></div>{% if not notification.read_at %}<form method="post" action="{{ path('tenant_notification_read', {slug: tenant.slug, id: notification.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.public_id) }}"><button class="btn btn-sm btn-outline-secondary">Als gelesen markieren</button></form>{% endif %}</div>{% if notification.action_url %}<a href="{{ notification.action_url }}" class="btn btn-sm btn-primary mt-3">Öffnen</a>{% endif %}</div></article>{% else %}<div class="card border-0 shadow-sm"><div class="card-body text-body-secondary">Keine Benachrichtigungen vorhanden.</div></div>{% endfor %}</div>
{% endblock %}

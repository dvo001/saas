{% extends 'base.html.twig' %}{% block title %}Stammdaten · {{ tenant.name }}{% endblock %}{% block body %}<div class="d-flex justify-content-between mb-4"><h1 class="h2">Vereinsstammdaten</h1><a href="{{ path('tenant_dashboard',{slug:tenant.slug}) }}">Dashboard</a></div>{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('registries') }}"><input type="hidden" name="action" value="settings"><label class="me-3"><input type="checkbox" name="participants" value="1" {{ data.settings.participant_registry_enabled ? 'checked' }}> Teilnehmerstamm</label><label class="me-3"><input type="checkbox" name="teams" value="1" {{ data.settings.team_registry_enabled ? 'checked' }}> Mannschaftsstamm</label><button class="btn btn-sm btn-primary">Speichern</button></form></div></div>
<div class="row g-4"><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Organisation</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('registries') }}"><input type="hidden" name="action" value="organization"><input class="form-control mb-2" name="name" placeholder="Name" required><select class="form-select mb-2" name="type"><option value="club">Verein</option><option value="school">Schule</option><option value="company">Firma</option><option value="association">Verband</option><option value="other">Sonstige</option></select><input class="form-control mb-2" name="city" placeholder="Ort"><button class="btn btn-primary">Anlegen</button></form><hr>{% for item in data.organizations %}<div>{{ item.name }} <small>({{ item.organization_type }})</small></div>{% endfor %}</div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Teilnehmerstamm</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('registries') }}"><input type="hidden" name="action" value="participant"><input class="form-control mb-2" name="first_name" placeholder="Vorname" required><input class="form-control mb-2" name="last_name" placeholder="Nachname" required><input class="form-control mb-2" type="number" name="birth_year" placeholder="Geburtsjahr"><input class="form-control mb-2" name="city" placeholder="Ort"><button class="btn btn-primary">Anlegen</button></form><hr>{% for item in data.participants %}<div class="d-flex justify-content-between mb-2"><span>{{ item.first_name }} {{ item.last_name }}</span><form method="post" action="{{ path('tenant_registry_participant_delete',{slug:tenant.slug,id:item.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('registry_delete_'~item.public_id) }}"><label class="small"><input type="checkbox" name="anonymize" value="1"> Historie anonymisieren</label> <button class="btn btn-sm btn-outline-danger">Löschen</button></form></div>{% endfor %}</div></div></div>
<div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Mannschaftsstamm</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('registries') }}"><input type="hidden" name="action" value="team"><input class="form-control mb-2" name="name" placeholder="Teamname" required><input class="form-control mb-2" name="category" placeholder="Kategorie"><input class="form-control mb-2" name="contact_name" placeholder="Kontaktperson"><input class="form-control mb-2" type="email" name="contact_email" placeholder="Kontakt-E-Mail"><button class="btn btn-primary">Anlegen</button></form><hr>{% for item in data.teams %}<div class="d-flex justify-content-between mb-2"><span>{{ item.name }} <small>{{ item.category }}</small></span><form method="post" action="{{ path('tenant_registry_team_delete',{slug:tenant.slug,id:item.public_id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('team_registry_delete_'~item.public_id) }}"><button class="btn btn-sm btn-outline-danger">Löschen</button></form></div>{% endfor %}</div></div></div></div>{% endblock %}

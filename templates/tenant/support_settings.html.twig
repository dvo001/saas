{% extends 'base.html.twig' %}
{% block title %}Supportzugriff · {{ tenant.name }}{% endblock %}
{% block body %}
<div class="row justify-content-center"><div class="col-lg-7"><p class="eyebrow">Einstellungen</p><h1 class="h2">Supportzugriff</h1><p>Wenn aktiviert, können Plattformadmins nach Angabe eines protokollierten Grundes für höchstens zwei Stunden in den Verein wechseln. Der aktive Supportmodus ist jederzeit sichtbar.</p>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('support_settings') }}"><div class="form-check form-switch mb-4"><input type="hidden" name="enabled" value="0"><input class="form-check-input" type="checkbox" role="switch" id="enabled" name="enabled" value="1" {% if tenant.supportImpersonationEnabled %}checked{% endif %}><label class="form-check-label" for="enabled">Begründeten Supportzugriff erlauben</label></div><button class="btn btn-primary" type="submit">Speichern</button> <a class="btn btn-outline-secondary" href="{{ path('tenant_dashboard', {slug: tenant.slug}) }}">Zurück</a></form></div></div></div></div>
{% endblock %}

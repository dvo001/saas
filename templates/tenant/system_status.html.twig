{% extends 'base.html.twig' %}
{% block title %}Systemstatus · {{ tenant.name }}{% endblock %}
{% block body %}<div class="mb-4"><p class="eyebrow">Betrieb</p><h1 class="h2">Systemstatus</h1></div><div class="row g-3"><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Plattform</h2><span class="badge text-bg-{{ status.overall == 'operational' ? 'success' : 'warning' }}">{{ status.overall }}</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Mailversand</h2><span class="badge text-bg-{{ status.mail == 'configured' ? 'success' : 'secondary' }}">{{ status.mail }}</span></div></div></div><div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h6">Wartung</h2><span class="badge text-bg-{{ status.maintenance ? 'warning' : 'success' }}">{{ status.maintenance ? 'aktiv' : (status.next_maintenance ? 'geplant' : 'keine') }}</span>{% if status.next_maintenance %}<small class="d-block mt-2">{{ status.next_maintenance.starts_at|date('d.m.Y H:i', 'Europe/Zurich') }} Uhr</small>{% endif %}</div></div></div></div>{% endblock %}

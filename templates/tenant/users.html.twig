{% extends 'base.html.twig' %}
{% block title %}Benutzer · {{ tenant.name }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-start mb-4"><div><p class="eyebrow">Einstellungen</p><h1 class="h2">Benutzer und Rollen</h1></div><div>{% if is_granted('ROLE_TENANT_OWNER') %}<a class="btn btn-outline-danger" href="{{ path('owner_transfer', {slug: tenant.slug}) }}">Owner wechseln</a>{% endif %} <a class="btn btn-outline-secondary" href="{{ path('tenant_dashboard', {slug: tenant.slug}) }}">Zum Dashboard</a></div></div>
{% for type, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ type }}">{{ message }}</div>{% endfor %}{% endfor %}
{% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
<div class="row g-4"><div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5">Benutzer einladen</h2><form method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('invite_user') }}"><div class="mb-3"><label class="form-label" for="email">E-Mail-Adresse</label><input class="form-control" id="email" name="email" type="email" required></div><div class="mb-3"><label class="form-label" for="role">Rolle</label><select class="form-select" id="role" name="role" required>{% for role in roles %}<option value="{{ role.value }}">{{ role.label }}</option>{% endfor %}</select></div><button class="btn btn-primary" type="submit">Einladung senden</button></form></div></div></div><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Name</th><th>Rolle</th><th>Status</th><th><span class="visually-hidden">Aktionen</span></th></tr></thead><tbody>{% for user in users %}<tr><td>{{ user.displayName }}<small class="d-block text-body-secondary">{{ user.email }}</small></td><td>{{ user.tenantRole.label }}</td><td>{{ not user.emailConfirmed ? 'Eingeladen' : (user.active ? 'Aktiv' : 'Deaktiviert') }}</td><td class="text-end">{% if user.tenantRole.value != 'owner' %}<form class="d-inline" method="post" action="{{ path('tenant_user_action', {slug: tenant.slug, publicId: user.publicId, action: user.active ? 'deactivate' : 'activate'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('user_action_' ~ user.publicId) }}"><button class="btn btn-sm btn-outline-secondary" type="submit">{{ user.active ? 'Deaktivieren' : 'Aktivieren' }}</button></form> <form class="d-inline" method="post" action="{{ path('tenant_user_action', {slug: tenant.slug, publicId: user.publicId, action: 'unlock'}) }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('user_action_' ~ user.publicId) }}"><button class="btn btn-sm btn-outline-secondary" type="submit">Entsperren</button></form> <a class="btn btn-sm btn-outline-danger" href="{{ path('tenant_user_delete', {slug: tenant.slug, publicId: user.publicId}) }}">Löschen</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div></div></div>
{% endblock %}
